<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Atualizações da app (o Android pede confirmação a cada instalação). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- As apps do GoatLauncher vêm da TV por http (só na rede de casa). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="GoatRemote"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoatRemote"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
        <!-- Abrem a app: o mosaico das definições rápidas e o widget do ecrã principal. -->
        <service
            android:name=".RemoteTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_logo"
            android:label="GoatRemote"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".RemoteShapeTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_remote"
            android:label="GoatRemote"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver
            android:name=".RemoteWidget"
            android:exported="true"
            android:label="GoatRemote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_widget" />
        </receiver>
    </application>
</manifest>
